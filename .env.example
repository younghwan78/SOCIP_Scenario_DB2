DATABASE_URL=postgresql+psycopg2://scenario_user:scenario_pass@localhost:15432/scenario_db
SCENARIODB_API_BASE=http://127.0.0.1:18000/api/v1
SCENARIO_DB_QUERY_FACETS_CACHE_TTL_SECONDS=60
SCENARIO_DB_QUERY_MAX_CANDIDATES=5000
SCENARIO_DB_QUERY_MAX_EVIDENCE_ROWS=20000
SCENARIO_DB_QUERY_MAX_ISSUE_ROWS=5000
SCENARIO_DB_QUERY_FACETS_MAX_CANDIDATES=10000
SCENARIO_DB_RULE_CACHE_TTL_SECONDS=5
SCENARIO_DB_ADMIN_ENDPOINTS_ENABLED=false
SCENARIO_DB_API_PRINCIPALS={"architect@example.com":{"secret":"replace-with-a-long-random-secret","roles":["writer"]},"operator@example.com":{"secret":"replace-with-another-long-random-secret","roles":["admin"]}}
# Deprecated migration-only fallback:
# SCENARIO_DB_MUTATION_API_KEYS={"legacy@example.com":"replace-with-a-long-random-secret"}
SCENARIO_DB_MUTATION_AUTH_DISABLED=false
SCENARIODB_API_KEY_ID=architect@example.com
SCENARIODB_API_KEY=replace-with-a-long-random-secret
